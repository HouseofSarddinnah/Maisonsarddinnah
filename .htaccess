# Apache .htaccess Configuration for 301 Redirect
# Redirects all www traffic to non-www canonical domain

# Enable Rewrite Engine
RewriteEngine On

# Redirect HTTP to HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://maisonsarddinnah.com/$1 [R=301,L]

# Redirect www to non-www (HTTPS)
RewriteCond %{HTTP_HOST} ^www\.maisonsarddinnah\.com [NC]
RewriteRule ^(.*)$ https://maisonsarddinnah.com/$1 [R=301,L]

# Redirect www to non-www (HTTP) - for any remaining HTTP www requests
RewriteCond %{HTTP_HOST} ^www\.maisonsarddinnah\.com [NC]
RewriteCond %{HTTPS} on
RewriteRule ^(.*)$ https://maisonsarddinnah.com/$1 [R=301,L]
